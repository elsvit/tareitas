# Copy to .env.production for production builds:
#   cp .env.production.example .env.production
#
# Then push vars to EAS (cloud builds):
#   yarn sync-eas-env
#
# Or build locally with these vars:
#   yarn build-apk-prod

EXPO_PUBLIC_API_URL=https://api.tareitas.net

# Supabase (if used)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat production keys
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# Optional: real AdMob banner unit for release builds
# EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-XXXXXXXXXX/XXXXXXXXXX
