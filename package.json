{
  "name": "tareitas",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "Tareitas",
  "author": "Tareitas",
  "license": "MIT",
  "homepage": "https://tareitas.com",
  "scripts": {
    "start": "node ./scripts/run-with-translation-watch.js expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "node ./scripts/run-with-translation-watch.js expo start --android",
    "ios": "node ./scripts/run-with-translation-watch.js expo start --ios",
    "web": "node ./scripts/run-with-translation-watch.js expo start --web",
    "build-dev": "eas build -p android --profile development",
    "build-dev-ios": "eas build -p ios --profile development",
    "build-apk": "npx expo run:android --variant release",
    "build-apk-preview": "eas build -p android --profile preview",
    "build-apk-prod": "eas build -p android --profile production",
    "prebuild": "npx expo prebuild",
    "lint": "expo lint",
    "translations:sync": "node ./scripts/sync-translations.js",
    "translations:watch": "node ./scripts/sync-translations.js --watch"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo-google-fonts/rubik": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@redux-devtools/extension": "^4.0.0",
    "@reduxjs/toolkit": "^2.11.2",
    "date-fns": "^4.1.0",
    "expo": "54.0.34",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "^55.0.13",
    "expo-linking": "8.0.12",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "15.0.11",
    "i18next": "^26.0.8",
    "input-otp-native": "^0.6.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.75.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^2.31.1",
    "react-native-gesture-password": "^0.4.0",
    "react-native-get-random-values": "1.11.0",
    "react-native-paper": "^5.15.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-saga": "^1.4.2",
    "reselect": "^5.1.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/react": "~19.1.0",
    "@types/redux-logger": "^3.0.13",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.8.3",
    "react-native-svg-transformer": "^1.5.3",
    "redux-logger": "^3.0.6",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "router": {
      "appDir": "src/app"
    }
  }
}
