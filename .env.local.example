# Copy to .env.local for local development:
#   cp .env.local.example .env.local
#
# Then start the app with:
#   yarn start-local
#
# Local backend (NestJS on your Mac):
#   iOS Simulator:     http://localhost:3000
#   Android Emulator:  http://10.0.2.2:3000
#   Physical device:   http://YOUR_MAC_LAN_IP:3000

EXPO_PUBLIC_API_URL=http://localhost:3000

# RevenueCat test keys (optional for local dev builds)
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=test_...
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=test_...
