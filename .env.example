# Environment files
#
# Local development:
#   cp .env.local.example .env.local
#   yarn start-local
#
# Production builds (EAS / Play Store):
#   cp .env.production.example .env.production
#   yarn sync-eas-env          # upload vars to EAS for cloud builds
#   yarn build-apk-prod        # Android production (EAS)
#   yarn build-ios-prod        # iOS production (EAS)
#
# iOS App Store via Xcode Archive (local, uses .env.production):
#   yarn archive-ios-prod      # writes ios/.xcode.env.local + opens workspace
#   # or: yarn prepare-ios-prod-archive  then open Xcode and Product → Archive
#
# Files:
#   .env.local        - local dev (gitignored)
#   .env.production   - production values (gitignored)
#
# See .env.local.example and .env.production.example for templates.
