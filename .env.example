# Copy to .env and adjust for your machine.
#
# Local backend (NestJS on your Mac):
#   iOS Simulator:     http://localhost:3000
#   Android Emulator:  http://10.0.2.2:3000
#   Physical device:   http://YOUR_MAC_LAN_IP:3000
#                      (find IP: System Settings → Network, or run: ipconfig getifaddr en0)
#
# Production / staging builds use EAS secrets (see eas.json), not this file.

EXPO_PUBLIC_API_URL=http://localhost:3000
